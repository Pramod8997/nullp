# Digital Twin EMS — Environment Variables Template
# Copy this file to .env and fill in production values
# ──────────────────────────────────────────────────

# MQTT Broker Credentials (must match mosquitto/config/passwd)
MQTT_USERNAME=pipeline
MQTT_PASSWORD=changeme_pipeline_password

# API Authentication Key
EMS_API_KEY=changeme-ems-prod-key

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Gemini API Key (for ML-related features, if used)
# GEMINI_API_KEY=your-gemini-key-here
