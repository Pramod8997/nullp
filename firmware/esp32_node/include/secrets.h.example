/**
 * secrets.h.example — per-node credentials for the EMS ESP32 firmware.
 *
 * Copy to `secrets.h` in this same directory and fill in real values:
 *
 *     cp firmware/esp32_node/include/secrets.h.example \
 *        firmware/esp32_node/include/secrets.h
 *
 * `secrets.h` is gitignored. Never put a real Wi-Fi password or broker
 * password in this .example file, or in main.cpp — both are tracked.
 */
#ifndef EMS_SECRETS_H
#define EMS_SECRETS_H

// ── Wi-Fi ────────────────────────────────────────────────────────────────
// The ESP32 radio is 2.4 GHz only. A 5 GHz-only SSID will never associate.
#define EMS_WIFI_SSID       "your-2.4GHz-ssid"
#define EMS_WIFI_PASSWORD   "your-wifi-password"

// ── MQTT broker ──────────────────────────────────────────────────────────
// The LAN IP of the machine running mosquitto + run_pipeline.py, reachable
// from the ESP32's subnet. NOT "localhost" — that would be the ESP32 itself.
// Confirm with `ip -4 addr show scope global` on the backend host, and note
// that a phone-hotspot address (172.20.10.x) changes between sessions.
#define EMS_MQTT_SERVER     "192.168.1.100"
#define EMS_MQTT_PORT       1883

// Must match a user in the broker's password_file AND the per-user topic
// grants in mosquitto/config/acl. The device must use the dedicated `esp32`
// user — it is created at Gate 0 of BRINGUP_RUNBOOK.md via
// `mosquitto_passwd <passwd-file> esp32 <secret>` (it does not ship in the
// repo's hashed passwd). The ACL grants it read on `home/plug/+/command` and
// write on the sensor/status/ack topics only, so the firmware credential
// cannot publish backend commands. Do NOT fall back to `ems_pipeline` here:
// that user can write `home/plug/+/command` (i.e. toggle mains).
#define EMS_MQTT_USER       "esp32"
#define EMS_MQTT_PASSWORD   "your-broker-password"

// ── Node identity ────────────────────────────────────────────────────────
// Must match a key under `devices:` in the active config profile. The
// physical rig profile (config/config.hardware.yaml) declares exactly one:
// `node_bench_agg`. A mismatch here means the backend silently ignores every
// reading this node publishes.
#define EMS_DEVICE_ID       "node_bench_agg"

#endif  // EMS_SECRETS_H
